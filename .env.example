# ── LLM ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
# Override with your Azure OpenAI endpoint to use Azure instead of OpenAI
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-large
# Must match the chosen model: text-embedding-3-large=3072, text-embedding-3-small=1536
EMBEDDING_DIMENSIONS=3072

# ── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=hybridrag_neo4j

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=devanalytics
POSTGRES_USER=hybridrag
POSTGRES_PASSWORD=hybridrag_postgres

# ── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Three domain collections
QDRANT_COLLECTION_TICKETS=dev_tickets
QDRANT_COLLECTION_ARCH_DOCS=dev_arch_docs
QDRANT_COLLECTION_POSTMORTEMS=dev_postmortems

# ── Retrieval Parameters ─────────────────────────────────────────────────────
TOP_K_RESULTS=5
MAX_RETRIEVAL_ITERATIONS=3

# ── Integration Endpoints ────────────────────────────────────────────────────
MCP_PORT=8001
A2A_PORT=8002
# Override with the externally reachable address when deploying beyond localhost
A2A_BASE_URL=http://localhost:8002
